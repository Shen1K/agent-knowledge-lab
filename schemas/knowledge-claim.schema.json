{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/agent-knowledge-lab/knowledge-claim.schema.json",
  "title": "Knowledge Claim",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "scope",
    "status",
    "confidence",
    "evidence_strength",
    "transferability",
    "schema_version",
    "evidence",
    "relations"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "knowledge_claim"
    },
    "title": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "status": {
      "enum": [
        "hypothesis",
        "reviewed",
        "validated",
        "conflicted",
        "deprecated"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_strength": {
      "enum": [
        "weak",
        "medium",
        "strong"
      ]
    },
    "transferability": {
      "enum": [
        "general",
        "domain",
        "project",
        "tool"
      ]
    },
    "schema_version": {
      "type": "number"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "object",
      "properties": {
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts_with": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "generalizes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "specializes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
