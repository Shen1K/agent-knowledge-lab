{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/agent-knowledge-lab/case-card.schema.json",
  "title": "Case Card",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "domain",
    "schema_version",
    "source",
    "status",
    "relations"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "case_card"
    },
    "title": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "schema_version": {
      "type": "number"
    },
    "source": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "archived"
      ]
    },
    "relations": {
      "type": "object"
    }
  }
}
